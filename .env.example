# DX-LAB-integration — copy values into your environment or into service-specific files.
# Next.js reads `frontend/.env.local` (not this file).
#
# **Backend LLM / NIM (recommended):** use a single file `backend/.env` with `DX_LAB_API_KEY`
# (see `backend/.env.example`). The hub and discovery load it automatically.

# ─── ACP hub (run: cd backend && python -m acp_hub.main) ─────────────────────
ACP_SERVER_HOST=127.0.0.1
ACP_SERVER_PORT=8010
# ACP_SERVER_URL=http://127.0.0.1:8010
# DATA_MANAGER_URL=http://127.0.0.1:8000
# PRINTER_3D_URL=http://127.0.0.1:5000
# DISCOVERY_AGENT_ROOT=  # unset = default backend/services/discovery_agent
# EXECUTOR_STEP_TIMEOUT=900
# Prefer `backend/.env` with DX_LAB_API_KEY instead of duplicating here.
# LLM_API_KEY=
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=meta/llama-3.1-70b-instruct

# ─── Frontend (put these in frontend/.env.local) ───────────────────────────
NEXT_PUBLIC_ACP_URL=http://127.0.0.1:8010
# Server-side proxy can also read ACP_SERVER_URL (same default as public if unset)
# ACP_SERVER_URL=http://127.0.0.1:8010
DRUG_SAFETY_API_URL=http://127.0.0.1:8002

# ─── Drug safety service (backend/services/drug_safety/run_web.py) ─────────
DRUG_SAFETY_PORT=8002

# ─── Discovery agent (backend/services/discovery_agent) ─────────────────────
# REINVENT_PATH=C:\path\to\REINVENT4
# SERPER_API_KEY=
# LLM_API_KEY=  # or NVIDIA_API_KEY / OPENAI_API_KEY for NIM-compatible endpoints

# ─── Data manager / ITD (port 8000 — do not overlap drug safety if both run) ─
