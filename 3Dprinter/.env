# .env
# ═══════════════════════════════════════════════════════════════
# INTELLIGENT TARGET DISCOVERY AGENT - CONFIGURATION
# ═══════════════════════════════════════════════════════════════

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 1. LOCAL LLAMA3.1 (Token Factory - University)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# LLAMA_PROVIDER=local_vllm
# LLAMA_SERVER_URL=https://tokenfactory.esprit.tn/api
# LLAMA_MODEL=hosted_vllm/Llama-3.1-70B-Instruct
# LLAMA_API_KEY="APIKEY_TOKENFACTORY"
# LLAMA_VERIFY_SSL=False
# LLAMA_TEMPERATURE=0.1
# LLAMA_MAX_TOKENS=1000

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 2. GEMMA 4 (Google AI Studio) - ACTIVE PAR DÉFAUT
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
GEMMA_PROVIDER=google_ai_studio
GEMMA_MODEL=gemma-3-27b-it
GEMMA_API_KEY=GEMMA_API_KEY_GOOGLE_AI_STUDIO
GEMMA_TEMPERATURE=0.1
GEMMA_MAX_TOKENS=1000
GEMMA_TOP_P=0.9

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 3. NVIDIA NIM APIs (ESMFold + DiffDock)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
NVIDIA_API_KEY=NVIDIA_API_KEY_ENV_VAR
ESMFOLD_ENDPOINT=https://health.api.nvidia.com/v1/biology/nvidia/esmfold
ESMFOLD_ENABLED=True
DIFFDOCK_ENDPOINT=https://health.api.nvidia.com/v1/biology/mit/diffdock
DIFFDOCK_ENABLED=True

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 4. APPLICATION SETTINGS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=True
LOG_LEVEL=INFO

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 5. PIPELINE OPTIONS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
USE_LLAMA=False
USE_GEMMA=True
USE_RDKIT=True
USE_NIM_APIS=True
PIPELINE_TIMEOUT_S=300
VERBOSE=True