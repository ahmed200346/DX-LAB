# Copy to `backend/.env` (gitignored). One key for NVIDIA NIM / OpenAI-compatible stacks.
#
# Used by: acp_hub (planner/executor), discovery_agent, drug_safety (if it reads LLM env),
# hypothesis_assistant, and any service that imports `dx_lab_env.load_shared_dotenv()`.

DX_LAB_API_KEY=

# NIM defaults for the hub (override as needed)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=moonshotai/kimi-k2.5

# Optional alias (same value as DX_LAB_API_KEY if you prefer this name only)
# API_KEY=
