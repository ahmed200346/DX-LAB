# Copy to .env.local for local dev (`frontend/.env.local` is gitignored by parent rules if configured).

# Browser + server: ACP hub (proxied via /api/acp/*)
NEXT_PUBLIC_ACP_URL=http://127.0.0.1:8010

# Optional: server-side only (Route Handlers); defaults to NEXT_PUBLIC_ACP_URL
# ACP_SERVER_URL=http://127.0.0.1:8010

# Drug safety FastAPI (default 8002 — avoids collision with ITD on 8000)
DRUG_SAFETY_API_URL=http://127.0.0.1:8002

# Data Manager / ITD service (proxied via /api/data-manager/*)
DATA_MANAGER_API_URL=http://127.0.0.1:8000

# Hypothesis Assistant (proxied via /api/hypothesis/*)
# Start with: uvicorn api:app --host 127.0.0.1 --port 8003
HYPOTHESIS_API_URL=http://127.0.0.1:8003

# 3D Printer service (proxied via /api/printer/*)
PRINTER_3D_API_URL=http://127.0.0.1:5000
